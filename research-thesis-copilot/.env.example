# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Research scope ---
# arXiv category to watch for the ingestion workflow, e.g. cs.CL, cs.AI, cs.LG
ARXIV_CATEGORY=cs.CL
ARXIV_MAX_RESULTS=15

# --- Digest email (used by the n8n weekly-digest workflow) ---
DIGEST_RECIPIENT=you@example.com

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
